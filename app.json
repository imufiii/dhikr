{
  "expo": {
    "name": "Dhikr",
    "slug": "dhikr",
    "version": "1.1.21",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mufeedmuneer.dhikr",
      "supportsTablet": false,
      "privacyPolicyUrl": "https://imufiii.github.io/dhikr/privacy.html",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to calculate local prayer times.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mufeedmuneer.dhikr",
      "privacyPolicyUrl": "https://imufiii.github.io/dhikr/privacy.html",
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A84C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to calculate local prayer times."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd839db7-b14c-46ce-a20c-dac078d4ad0e"
      }
    },
    "owner": "mufeedmuneer"
  }
}
