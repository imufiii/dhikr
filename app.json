{
  "expo": {
    "name": "Dhikr",
    "slug": "dhikr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mufeedmuneer.dhikr",
      "supportsTablet": false,
      "privacyPolicyUrl": "https://imufiii.github.io/dhikr/privacy.html",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to calculate local prayer times.",
        "NSUserTrackingUsageDescription": "Dhikr does not track you."
      }
    },
    "android": {
      "package": "com.mufeedmuneer.dhikr",
      "privacyPolicyUrl": "https://imufiii.github.io/dhikr/privacy.html",
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A84C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to calculate local prayer times."
        }
      ]
    ]
  }
}
